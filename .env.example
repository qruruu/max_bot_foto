# Copy/merge into .env. Never overwrite an existing token accidentally.
POSTGRES_PASSWORD=replace_with_random_hex_password
APP_ENV=development
APP_ORIGIN=http://localhost:8080
# Exact HTTPS origin of the optional public appeals subdomain (without a path).
# PUBLIC_APPEALS_ORIGIN=https://appeals.example.org
# APPEALS_HTTP_PORT=8081
APP_TIMEZONE=Asia/Yekaterinburg
COOKIE_SECURE=false
HTTP_PORT=8080
SESSION_HOURS=12

MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# At least 32 random URL-safe characters; e.g. python -c "import secrets; print(secrets.token_urlsafe(40))"
MAX_WEBHOOK_SECRET=
# Exact CDN suffixes accepted for authenticated MAX attachment URLs. Extend only after inspecting an actual API response.
MAX_DOWNLOAD_HOSTS=max.ru,max.com,okcdn.ru,mycdn.me,userapi.com
# MAX API and attachment downloads: certificate verification is disabled as requested.
MAX_VERIFY_TLS=false
# auto = polling for development, webhook for production. No public URL needed locally.
MAX_UPDATE_MODE=auto
# Optional only when MAX_VERIFY_TLS=true:
# MAX_CA_BUNDLE=/certs/max-ca.pem

YANDEX_DISK_TOKEN=
YANDEX_DISK_ROOT=MAX_PHOTOS
# After first saving company folders in the admin UI ("Обмен с АРМ"), DB settings take precedence.
# Do not rename existing archives by editing this value; old paths are preserved in folder history.
# JavaScript API key from https://developer.tech.yandex.ru/keys/ (visible in the browser).
# Allow both the operator domain and the public appeals domain in this key's domain restrictions.
YANDEX_MAPS_API_KEY=

# Local PyTorch model. No external AI API, key or subscription.
WORK_TYPE_CONFIDENCE_THRESHOLD=0.80
ML_AUTO_TRAIN=true
ML_MIN_SAMPLES=100
ML_MIN_PER_CLASS=20
ML_MIN_CLASSES=2
ML_MIN_NEW_LABELS=20
ML_MIN_VALIDATION_PER_CLASS=3
ML_MIN_MACRO_F1=0.70
ML_MIN_CLASS_PRECISION=0.90
ML_EPOCHS=8
ML_BATCH_SIZE=16
ML_LEARNING_RATE=0.0003
ML_THREADS=2
ML_CHECK_SECONDS=60
# Downloads generic ImageNet backbone once; never uploads photos.
ML_DOWNLOAD_BACKBONE=true
# Offline: mount official resnet18-f37072fd.pth and set its container path:
# ML_BACKBONE_PATH=/data/models/resnet18-f37072fd.pth
# Local PaddleOCR CPU models are bundled in the Docker image; no photo API calls.
OCR_BACKEND=paddle
OCR_THREADS=2
OCR_MODEL_DIR=/opt/ocr-models
# Tesseract is the local fallback (or select OCR_BACKEND=tesseract).
OCR_LANGUAGES=rus+eng
OCR_TIMEOUT=60
MAX_FILE_BYTES=52428800
MAX_IMAGE_PIXELS=60000000
DATA_DIR=/data
# Enable only after initialize-organizations. See docs/ORGANIZATIONS.md.
ORGANIZATIONS_ENABLED=false
# Only for running outside Compose:
# DATABASE_URL=postgresql+psycopg://maxphotos:password@127.0.0.1:5432/maxphotos

# Separate top-level Disk folders; empty values derive names from YANDEX_DISK_ROOT.
# Never put these folders inside the customer's photo archive.
YANDEX_EXCHANGE_ROOT=
YANDEX_TRAINING_ROOT=
YANDEX_SPAM_ROOT=
# Keep 3 verified JSON generations; retain displaced generations for this many hours.
EXCHANGE_READ_WINDOW_HOURS=24
